{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the local Screen Studio window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:event:default",
    "dialog:default",
    "opener:default",
    "clipboard-manager:default",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
    }
  ]
}

